# Copy to .env (or run `mochi config --api-key ...`) and edit.
# The project works with NO key at all: MOCHI_ENGINE=auto falls back to the
# deterministic offline engine when MOCHI_API_KEY is empty.

# ---- engine ---------------------------------------------------------------
# auto (key present -> LLM, else offline) | offline | openai
MOCHI_ENGINE=auto

# ---- any OpenAI-compatible endpoint --------------------------------------
#   DeepSeek    https://api.deepseek.com/v1     model: deepseek-chat
#   OpenRouter  https://openrouter.ai/api/v1    model: google/gemini-3
#   local vLLM  http://127.0.0.1:8000/v1        model: Qwen2.5-72B-Instruct
#   Ollama      http://127.0.0.1:11434/v1       model: qwen2.5:32b
MOCHI_BASE_URL=https://api.deepseek.com/v1
# The model reported in the final project: deepseek-V4.1-pro
MOCHI_MODEL=deepseek-V4.1-pro
MOCHI_API_KEY=

# ---- generation -----------------------------------------------------------
MOCHI_TEMPERATURE=0.2
MOCHI_MAX_TOKENS=4096
MOCHI_TIMEOUT=180

# ---- run control ----------------------------------------------------------
MOCHI_TOOL_CREATION=1
MOCHI_TEMPLATES=1
MOCHI_MAX_REVIEW_ROUNDS=3

# ---- disease context (MONDO_0005575 = colorectal cancer) ------------------
MOCHI_DISEASE=colorectal cancer
MOCHI_DISEASE_ID=MONDO_0005575
